@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:source a slm:SourceDocument ;
  rdfs:label "공식 자료"@ko ;
  slm:sourceUrl "https://example.org/source.pdf"^^xsd:anyURI ;
  slm:attachmentNumber "1" ;
  slm:fileSha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  slm:verificationStatus "official-source-checked" ;
  slm:rightsStatus "cleared" .
ex:group a slm:SubjectGroup ; rdfs:label "과학"@ko ; slm:schoolLevel "middle" ; slm:hasSource ex:source .
ex:course a slm:Course ; rdfs:label "과학"@ko ; slm:schoolLevel "middle" ; slm:courseCategory "common" ; slm:inSubjectGroup ex:group ; slm:hasSource ex:source ; slm:reviewStatus "candidate" .
ex:domain a slm:Domain ; rdfs:label "과학과 인류의 지속가능한 삶"@ko ; slm:domainOfCourse ex:course ; slm:hasSource ex:source ; slm:reviewStatus "candidate" .
ex:locator a slm:SourceLocator ; slm:officialCode "[9과01-01]" ; slm:sourcePage 1 ; slm:attachmentNumber "1" ; slm:fileSha256 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ; slm:sourceSection "과학 > 영역" ; slm:hasSource ex:source .
ex:standard a slm:AchievementStandard ; slm:officialCode "[9과01-01]" ; slm:summaryKind "mechanical-derivative" ; slm:inCourse ex:course ; slm:inDomain ex:domain ; slm:hasLocator ex:locator ; slm:hasSource ex:source .
ex:topic a slm:LearningTopic, slm:MiddleLearningTopic ; slm:schoolLevel "middle" ; slm:topicInCourse ex:course ; slm:inDomain ex:domain ; slm:alignsToStandard ex:standard ; slm:decompositionKind "standard-core" ; slm:facetKey "core" ; core:facetKey core:facet-core ; core:contentKind core:content-mechanical-derivative ; slm:facetKeyDetail "core" ; slm:evidence "설명한다"@ko ; slm:assessmentPrompt "근거를 말한다"@ko ; slm:hasSource ex:source .
ex:topic-facet a slm:LearningTopic, slm:MiddleLearningTopic ; slm:schoolLevel "middle" ; slm:topicInCourse ex:course ; slm:inDomain ex:domain ; slm:alignsToStandard ex:standard ; slm:decompositionKind "subject-facet" ; slm:facetKey "inquiry" ; core:facetKey core:facet-inquiry ; core:contentKind core:content-source-grounded-draft ; core:misconception "학습자는 자료가 많을수록 결론이 옳다고 생각한다."@ko ; core:contentSourceLocator ex:content-locator ; slm:facetKeyDetail "inquiry-data" ; slm:evidence "탐구를 설계한다"@ko ; slm:assessmentPrompt "자료를 해석한다"@ko ; slm:hasSource ex:source .
ex:content-locator a core:SourceLocator ; core:locatorKind core:locator-printed-page ; core:standardCode "[9과01-01]" ; core:printedPage 1 ; core:sourceSection "성취기준 적용 시 고려 사항" ; slm:hasSource ex:source .
ex:official-relation a slm:LearningRelation, slm:OfficialLearningRelation ; slm:layer "official" ; core:layerConcept core:layer-official ; slm:prerequisiteTopic ex:topic ; slm:dependentTopic ex:topic-facet ; slm:relationKind "required-prerequisite" ; slm:scope "same-course" ; slm:strength "required" ; slm:reason "공식 해설이 직접 연결한다."@ko ; slm:basisKind "official-source" ; slm:basis "별책9 성취기준 해설 p.1" ; slm:hasSource ex:source ; slm:reviewStatus "internal-reviewed" .
ex:candidate-relation a slm:LearningRelation, slm:CandidateLearningRelation ; slm:layer "pedagogical-candidate" ; core:layerConcept core:layer-pedagogical-candidate ; slm:prerequisiteTopic ex:topic ; slm:dependentTopic ex:topic-facet ; slm:relationKind "recommended-before" ; slm:scope "same-standard" ; slm:strength "recommended" ; slm:reason "핵심 주제를 먼저 다루기를 권장한다."@ko ; slm:basisKind "decomposition-order" ; slm:basis "R-FACET 분해 순서" ; slm:hasSource ex:source ; slm:reviewStatus "candidate" .
ex:step a slm:PathwayStep ; slm:stepOrder 1 ; slm:stepKind "foundation" ; slm:reason "기초를 확인한다."@ko ; slm:stepCourse ex:course .
ex:path a slm:IllustrativePathway ; slm:hasStep ex:step ; slm:notOfficialRequirement true ; slm:reviewStatus "candidate" .

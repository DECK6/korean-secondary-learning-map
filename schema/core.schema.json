{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dexa.art/learnmap/schema/secondary/core.schema.json",
  "title": "Korean Secondary Learning Map — shared core definitions",
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "elementaryTopicId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[a-z0-9][a-z0-9._:가-힣-]*$",
      "description": "korean-elementary-learning-map 릴리스에 핀된 초등 토픽 ID. 일부 교과(영어)는 ID에 한글 슬러그를 포함한다."
    },
    "releaseId": {
      "type": "string",
      "pattern": "^kr-2022-(middle|high-vocational|high|middle-high-bridge)-v[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9.-]+)?$"
    },
    "sourceRef": {
      "$ref": "#/$defs/stableId"
    },
    "verificationStatus": {
      "enum": [
        "needs-official-code-check",
        "official-web-checked",
        "official-source-checked",
        "public-doc-derived"
      ]
    },
    "reviewStatus": {
      "enum": [
        "candidate",
        "internal-reviewed",
        "subject-expert-reviewed",
        "field-reviewed",
        "rejected",
        "deprecated"
      ]
    },
    "relationLayer": {
      "enum": ["official", "pedagogical-candidate"],
      "description": "K-12 공통 계약 v1의 관계 2층. official은 공식 문서가 직접 뒷받침하는 선수 관계, pedagogical-candidate는 코드 순서·분해 순서로 만든 권장 순서다."
    },
    "facetKey": {
      "enum": [
        "concept",
        "procedure",
        "representation",
        "application",
        "inquiry",
        "communication",
        "reflection",
        "core"
      ],
      "description": "K-12 공통 facet 8종. 중학교 주제의 과목별 24종 원값은 facetKeyDetail에 보존한다."
    },
    "basisKind": {
      "enum": [
        "official-source",
        "official-code-order",
        "decomposition-order",
        "repository-authored",
        "expert-authored"
      ],
      "description": "관계 근거의 종류. official 층 파일은 official-source만 허용한다."
    },
    "contentKind": {
      "enum": ["mechanical-derivative", "source-grounded-draft"],
      "description": "주제 evidence·assessmentPrompts의 출처. mechanical-derivative는 성취기준 요약을 치환한 템플릿, source-grounded-draft는 data/kr/<level>/content 오버레이가 대체한 출처 기반 초안이다."
    },
    "rightsStatus": {
      "enum": ["hold", "needs-document-level-review", "cleared", "not-applicable"]
    },
    "baseRecord": {
      "type": "object",
      "required": [
        "id",
        "labelKorean",
        "sourceRefs",
        "verificationStatus",
        "reviewStatus",
        "sourceTextIncluded"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "labelKorean": { "type": "string", "minLength": 1 },
        "labelEnglish": { "type": ["string", "null"] },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "verificationStatus": { "$ref": "#/$defs/verificationStatus" },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
        "sourceTextIncluded": { "const": false }
      }
    },
    "sourceLocator": {
      "type": "object",
      "required": ["sourceId", "section"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/sourceRef" },
        "attachmentNo": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "pdfPage": { "type": ["integer", "null"], "minimum": 1 },
        "printedPage": { "type": ["integer", "null"], "minimum": 1 },
        "section": { "type": "string", "minLength": 1 },
        "code": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "textPolicy": {
      "type": "object",
      "required": ["officialTextIncluded", "summaryPolicy"],
      "properties": {
        "officialTextIncluded": { "const": false },
        "summaryPolicy": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "collectionEnvelopeBase": {
      "type": "object",
      "required": ["$schema", "profile", "releaseId", "recordType", "recordCount", "records"],
      "properties": {
        "$schema": { "type": "string", "format": "uri-reference" },
        "profile": { "enum": ["middle", "high", "high-vocational", "bridges"] },
        "releaseId": { "$ref": "#/$defs/releaseId" },
        "recordType": { "type": "string", "minLength": 1 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "records": { "type": "array" }
      }
    },
    "coverageGap": {
      "type": "object",
      "required": ["id", "description", "severity", "status", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["intentional", "low", "medium", "high", "unspecified"] },
        "status": { "enum": ["open", "in-review", "resolved", "accepted"] },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceRef" }
        }
      },
      "additionalProperties": false
    },
    "reviewRecord": {
      "type": "object",
      "required": ["id", "targetIds", "reviewStatus", "reviewKind", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "reviewStatus": { "$ref": "#/$defs/reviewStatus" },
        "reviewKind": { "enum": ["internal", "subject-expert", "field", "rights", "source"] },
        "note": { "type": "string", "minLength": 1 },
        "reviewerRole": { "type": ["string", "null"] },
        "reviewDate": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    }
  }
}
